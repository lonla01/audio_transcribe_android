<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.TranscribeApp"
        android:supportsRtl="true">

        <!-- Launcher screen: simple placeholder / instructions -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TranscribeApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TranscribeApp"
            android:windowSoftInputMode="adjustResize" />

        <!-- Share-target: this is what shows up when the user long-presses
             a WhatsApp voice note and taps "Share" -->
        <activity
            android:name=".TranscribeShareActivity"
            android:exported="true"
            android:label="@string/transcribe_share_label"
            android:theme="@style/Theme.Transparent.Overlay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Fallback: some WhatsApp builds share voice notes as octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

    </application>

</manifest>
