<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/cardBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_transcribing"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:textColor="@color/accent" />

            <ProgressBar
                android:id="@+id/loadingPulse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                style="?android:attr/progressBarStyle" />

            <com.voicetext.transcribe.MaxHeightScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay">

                <TextView
                    android:id="@+id/transcriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    android:textColor="@color/textPrimary"
                    android:visibility="gone" />

            </com.voicetext.transcribe.MaxHeightScrollView>

            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/copyBtn"
                    android:textColor="@color/borderless_button_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/action_copy_close"
                    style="?android:attr/borderlessButtonStyle" />

                <Button
                    android:id="@+id/sendBackBtn"
                    android:textColor="@color/borderless_button_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_send_back"
                    style="?android:attr/borderlessButtonStyle" />

            </LinearLayout>

            <Button
                android:id="@+id/openSettingsBtn"
                android:textColor="@color/borderless_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="end"
                android:text="@string/action_open_settings"
                android:visibility="gone"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
