<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep transcripts and the API key on this phone only, out of
     both cloud backup and device-to-device transfer. (allowBackup="false"
     covers older Android versions.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
